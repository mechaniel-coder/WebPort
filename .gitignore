# Node — only ever needed for the optional build/verify tooling, never for hosting.
node_modules/
npm-debug.log*
package-lock.json

# cinematic/ is a real Next.js app (npm is its actual toolchain, not optional),
# so its lockfile is committed for reproducible installs.
!cinematic/package-lock.json

# Verification artefacts
.playwright/
screenshots/
shots/
test-results/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# NOTE: dist/ is intentionally NOT ignored.
# The built output is committed so the sites can be hosted straight from a clone
# with no toolchain. See HOSTING.md.
