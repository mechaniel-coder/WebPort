{
  "name": "webport",
  "version": "1.0.0",
  "private": true,
  "description": "A portfolio of four production-grade websites, generated as static HTML with zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js",
    "serve": "node serve.js",
    "verify": "node verify.js",
    "check": "node build.js && node verify.js",
    "check:browser": "node build.js && node browser-check.js",
    "screenshots": "node build.js && node browser-check.js --shots",
    "publish:branch": "git subtree push --prefix dist origin gh-pages"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "playwright-core": "^1.62.1"
  }
}
